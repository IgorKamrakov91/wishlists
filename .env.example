# Local development defaults
PHX_SERVER=true
PHX_HOST=localhost
PORT=4000
POOL_SIZE=10
ECTO_IPV6=false
TELEGRAM_INIT_TTL_SECONDS=86400

# Secrets and service credentials
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=replace-with-generated-secret
DATABASE_URL=ecto://postgres:postgres@localhost/wishlists_dev
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
RESEND_API_KEY=replace-with-your-resend-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key

# Deployment-only clustering variables, for example on Fly.io.
DNS_CLUSTER_QUERY=
