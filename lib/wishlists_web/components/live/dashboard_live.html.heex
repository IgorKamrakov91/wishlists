<div
  class="min-h-screen bg-gradient-to-b from-indigo-100 via-purple-50 to-pink-100"
  phx-hook="CardConfettiEffect"
  id="card-confetti-container"
>
  <header class="bg-white/90 backdrop-blur-sm shadow-md">
    <div class="max-w-7xl mx-auto py-4 px-4 sm:py-6 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center space-x-3">
          <div class="h-10 w-10 sm:h-12 sm:w-12 bg-indigo-600 rounded-full flex items-center justify-center">
            <.icon name="hero-sparkles" class="h-5 w-5 sm:h-6 sm:w-6 text-white" />
          </div>
          <div>
            <h1
              class="text-2xl sm:text-3xl font-bold text-indigo-600"
              id="wishverse-header"
              phx-hook="SparkleEffect"
            >
              {gettext("Your Wishverse")}
            </h1>
            <p class="text-sm text-gray-600 hidden sm:block">
              {gettext("Where dreams come true")}
            </p>
          </div>
        </div>

        <.link
          href={~p"/auth/sign_out"}
          method="delete"
          class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-full transition-all duration-300 flex items-center justify-center space-x-2 text-sm"
        >
          <.icon name="hero-arrow-right-on-rectangle" class="h-4 w-4" />
          <span>{gettext("Logout")}</span>
        </.link>
      </div>
    </div>
  </header>

  <div
    class="fixed top-0 left-0 right-0 bg-white/95 backdrop-blur-sm shadow-lg transform transition-all duration-300 z-30 px-4 sm:px-0"
    id="floating-folders-bar"
    style="transform: translateY(-100%)"
    phx-hook="FloatingBar"
  >
    <div class="max-w-7xl mx-auto py-3 px-4 sm:px-6 lg:px-8">
      <div class="flex space-x-4 overflow-x-auto hide-scrollbar pb-2" id="floating-folders-container" phx-hook="DragAndDrop">
        <div class="flex-none">
          <div class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-xl p-3">
            <span class="text-sm font-medium">{gettext("Drop to add to:")}</span>
          </div>
        </div>
        <%= for folder <- @folders do %>
          <div class="flex-none">
            <div
              class="bg-white/80 backdrop-blur-sm rounded-xl p-3 shadow-md hover:shadow-lg transition-all duration-200 drag-target transform hover:-translate-y-0.5"
              data-folder-id={folder.id}
              data-owner={if folder.user_id == @current_user.id, do: "true", else: "false"}
              id={"floating-folder-#{folder.id}"}
            >
              <div class="flex items-center space-x-3">
                <div class="h-6 w-6 bg-indigo-100 rounded-full flex items-center justify-center">
                  <.icon name="hero-folder" class="h-4 w-4 text-indigo-600" />
                </div>
                <div class="flex items-center space-x-2">
                  <span class="font-medium text-sm text-indigo-900">{folder.name}</span>
                  <span class="text-xs bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded-full">
                    {folder.card_count}
                  </span>
                </div>
              </div>

              <div class="absolute inset-0 border-2 border-dashed border-indigo-300 rounded-xl opacity-0 pointer-events-none drag-area">
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Wishlists Section -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span>🎁</span> {gettext("Magic Collections")}
          </h2>
          <p class="text-sm text-gray-600">
            {gettext("Organize your wishes into magical collections")}
          </p>
        </div>

        <button
          phx-click="new_folder"
          class="w-full sm:w-auto bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-4 py-2 sm:px-6 sm:py-3 rounded-full hover:from-indigo-700 hover:to-purple-700 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center justify-center space-x-2 group"
        >
          <div class="relative">
            <.icon
              name="hero-plus"
              class="h-5 w-5 transition-transform duration-300 group-hover:scale-110"
            />
          </div>
          <span>{gettext("New Collection")}</span>
        </button>
      </div>

<!-- Filters and Folders -->
      <div class="flex flex-col sm:flex-row gap-6">
        <!-- Filters -->
        <div class="w-full sm:w-48 bg-white/50 backdrop-blur-sm rounded-xl p-2 flex-shrink-0 mb-4">
          <div class="space-y-1">
            <button
              phx-click="filter_folders"
              phx-value-filter="all"
              class={[
                "w-full px-3 py-1.5 rounded-lg text-left transition-all duration-200",
                "flex items-center space-x-2",
                @current_filter == "all" &&
                  "bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-md",
                @current_filter != "all" &&
                  "hover:bg-white/50 text-gray-700 hover:text-indigo-700"
              ]}
            >
              <.icon name="hero-squares-2x2" class="h-4 w-4" />
              <span class="text-sm font-medium">{gettext("All Collections")}</span>
              <span class="ml-auto bg-white/20 px-1.5 py-0.5 rounded-full text-xs">
                {length(@folders) + length(@followed_folders)}
              </span>
            </button>

            <button
              phx-click="filter_folders"
              phx-value-filter="own"
              class={[
                "w-full px-3 py-1.5 rounded-lg text-left transition-all duration-200",
                "flex items-center space-x-2",
                @current_filter == "own" &&
                  "bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-md",
                @current_filter != "own" &&
                  "hover:bg-white/50 text-gray-700 hover:text-indigo-700"
              ]}
            >
              <.icon name="hero-folder" class="h-4 w-4" />
              <span class="text-sm font-medium">{gettext("My Collections")}</span>
              <span class="ml-auto bg-white/20 px-1.5 py-0.5 rounded-full text-xs">
                {length(@folders)}
              </span>
            </button>

            <button
              phx-click="filter_folders"
              phx-value-filter="shared"
              class={[
                "w-full px-3 py-1.5 rounded-lg text-left transition-all duration-200",
                "flex items-center space-x-2",
                @current_filter == "shared" &&
                  "bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-md",
                @current_filter != "shared" &&
                  "hover:bg-white/50 text-gray-700 hover:text-indigo-700"
              ]}
            >
              <.icon name="hero-share" class="h-4 w-4" />
              <span class="text-sm font-medium">{gettext("Shared")}</span>
              <span class="ml-auto bg-white/20 px-1.5 py-0.5 rounded-full text-xs">
                {length(@followed_folders)}
              </span>
            </button>
          </div>
        </div>

        <div class="flex-1 min-w-0">
          <div class="relative" id="folders-container" phx-hook="DragAndDrop">
            <div class="overflow-x-auto hide-scrollbar -mr-4 min-h-[100px]">
              <div class="flex space-x-4 pb-4 pr-4">
                <%= for folder <- filter_folders(@folders, @followed_folders, @current_filter) do %>
                  <div class="flex-none w-64">
                    <div
                      class={[
                        "bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 relative group transform hover:-translate-y-1 drag-target",
                        is_map(folder) && Map.has_key?(folder, :user_id) &&
                          folder.user_id != @current_user.id &&
                          "bg-gradient-to-r from-purple-100 to-pink-100"
                      ]}
                      data-folder-id={folder.id}
                      data-owner={
                        if folder.user_id == @current_user.id, do: "true", else: "false"
                      }
                      id={"folder-drop-target-#{folder.id}"}
                    >
                      <.link
                        navigate={get_folder_path(folder, @current_user)}
                        class="absolute inset-0 z-10"
                      >
                      </.link>

                      <div class="absolute -top-2 -right-2 opacity-0 group-hover:opacity-100 transition-opacity">
                        <span class="inline-block animate-bounce">✨</span>
                      </div>

                      <div class="flex justify-between items-center mb-2">
                        <h3 class="text-xl font-bold text-indigo-900 truncate max-w-[11ch]">{folder.name}</h3>
                        <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                          {folder.card_count} {if folder.card_count == 1,
                            do: gettext("item"),
                            else: gettext("items")}
                        </span>
                      </div>

                      <div class="mb-3 min-h-[1.5rem]">
                        <%= if folder.event_date do %>
                          <span class={[
                            "font-medium",
                            cond do
                              Date.compare(folder.event_date, @current_time) == :lt ->
                                "text-purple-600"

                              Date.diff(folder.event_date, @current_time) == 0 ->
                                "text-emerald-600"

                              Date.diff(folder.event_date, @current_time) == 1 ->
                                "text-indigo-600"

                              true ->
                                "text-indigo-700"
                            end
                          ]}>
                            {format_event_date(folder.event_date)}
                          </span>
                        <% else %>
                          <span class="text-gray-400">
                            {gettext("No event date set")}
                          </span>
                        <% end %>
                      </div>

                      <div class="flex justify-end">
                        <div class="flex items-center space-x-2">
                          <%= if is_map(folder) && Map.has_key?(folder, :user_id) && folder.user_id != @current_user.id do %>
                            <span class="bg-purple-600 text-white text-xs px-2 py-1 rounded-full">
                              {gettext("Shared by")} {folder.user.account.username}
                            </span>
                          <% else %>
                            <div class="text-purple-600 hover:text-purple-800 font-medium flex items-center space-x-1 group">
                              <span>{gettext("Open Collection")}</span>
                              <.icon
                                name="hero-sparkles"
                                class="h-4 w-4 group-hover:animate-pulse"
                              />
                            </div>
                          <% end %>
                        </div>
                      </div>

                      <div class="absolute inset-0 border-2 border-dashed border-indigo-300 rounded-2xl opacity-0 pointer-events-none drag-area">
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

<!-- Wishes Section -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span>⭐</span> {gettext("Your Wishes")}
          </h2>
          <p class="text-sm text-gray-600">{gettext("Dreams waiting to come true")}</p>
        </div>

        <button
          phx-click="new_card"
          class="w-full sm:w-auto bg-gradient-to-r from-purple-600 to-pink-600 text-white px-4 py-2 sm:px-6 sm:py-3 rounded-full hover:from-purple-700 hover:to-pink-700 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center justify-center space-x-2"
        >
          <.icon name="hero-sparkles" class="h-5 w-5" />
          <span>{gettext("Make a Wish")}</span>
        </button>
      </div>

      <%= if Enum.empty?(@cards) do %>
        <!-- Empty state -->
        <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg p-6 sm:p-12 text-center">
          <h3 class="text-2xl font-bold text-indigo-900 mb-4">
            {gettext("Your wish list is empty")}
          </h3>
          <p class="text-indigo-600 mb-8">
            {gettext(
              "Add your wish by clicking 'Make a Wish' button. Then you can drag it to any collection above!"
            )}
          </p>
        </div>
      <% else %>
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6"
          id="cards-container"
          phx-hook="DragOrder"
        >
          <%= for {card, index} <- Enum.with_index(@cards, 1) do %>
            <div
              data-card-id={card.id}
              draggable="true"
              data-position={index}
              class="cursor-move w-full touch-none"
              id={"card-#{card.id}"}
              phx-hook="DragCard"
            >
              <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 group transform hover:-translate-y-1 h-full">
                <!-- Image section with click handler -->
                <div
                  class="relative h-48 mb-4 cursor-pointer"
                  phx-click="edit_card"
                  phx-value-id={card.id}
                >
                  <img
                    src={if card.image_url && card.image_url != "", do: card.image_url, else: "/images/gift.jpg"}
                    alt={card.title}
                    class="w-full h-full object-cover rounded-xl"
                    loading="lazy"
                    phx-hook="ImageLoader"
                    id={"image-#{card.id}"}
                    onerror="this.src='/images/gift.jpg'"
                  />
                  <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
                    <div class="absolute top-2 right-2 bg-white/90 w-8 h-8 rounded-full p-1.5 shadow-md opacity-0 group-hover:opacity-100 transition-opacity hover:bg-rose-50 hover:text-rose-700 flex items-center justify-center">
                      <.icon name="hero-pencil" class="h-5 w-5 text-purple-600" />
                      <!-- Changed to pencil icon to indicate edit -->
                    </div>
                  </div>
                </div>

                <h3 class="text-xl font-bold text-indigo-900 mb-4 line-clamp-1">{card.title}</h3>

                <div class="flex items-center justify-between">
                  <%= if card.link_url do %>
                    <a
                      href={card.link_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-purple-600 hover:text-purple-800 text-sm flex items-center space-x-1"
                    >
                      <span>{gettext("Visit Link")}</span>
                      <.icon name="hero-arrow-top-right-on-square" class="h-4 w-4" />
                    </a>
                  <% end %>

                  <div class="text-indigo-400 text-sm flex items-center space-x-1">
                    <.icon name="hero-sparkles" class="h-4 w-4" />
                    <span>{gettext("Drag to add to Collection")}</span>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <div
        class="fixed bottom-4 right-4 sm:bottom-8 sm:right-8"
        id="delete-bucket"
        phx-hook="DeleteBucket"
      >
        <!-- Larger hit area for dropping -->
        <div class="absolute inset-0 rounded-full" id="delete-bucket-dropzone"></div>

        <div class="relative w-full h-full flex items-center justify-center">
          <!-- Main bucket button -->
          <div class="w-16 h-16 bg-red-500 rounded-full shadow-lg flex items-center justify-center cursor-pointer hover:bg-red-600 transition-colors">
            <.icon name="hero-trash" class="h-8 w-8 text-white" />
          </div>

<!-- Dashed border container - made larger -->
          <div
            class="absolute -inset-4 rounded-full border-2 border-dashed border-red-500 opacity-0 transition-all duration-300"
            id="delete-bucket-border"
          >
          </div>

<!-- Visual feedback overlay -->
          <div
            class="absolute inset-0 bg-red-600 rounded-full opacity-0 transition-all duration-300"
            id="delete-bucket-overlay"
          >
          </div>
        </div>
      </div>
    </section>
  </main>

  <%= if @show_modal do %>
    <%= case @modal_type do %>
      <% :folder -> %>
        <.live_component
          module={WishlistsWeb.FolderLive.FolderFormComponent}
          id="folder-form"
          action={@action}
          folder={@folder}
          modal_title={@modal_title}
          submit_button_text={@submit_button_text}
          current_user={@current_user}
        />
      <% :card -> %>
        <.live_component
          module={WishlistsWeb.CardLive.CardFormComponent}
          id="new-card"
          action={@action}
          card={@card}
          modal_title={@modal_title}
          submit_button_text={@submit_button_text}
          current_user={@current_user}
        />
      <% :delete_confirmation -> %>
        <.modal id="delete-confirmation">
          <div class="p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">
              {gettext("Are you sure you want to delete this wish?")}
            </h3>
            <p class="text-sm text-gray-500 mb-6">
              {gettext("This action cannot be undone.")}
            </p>
            <div class="flex justify-end space-x-3">
              <button
                phx-click="cancel_delete"
                class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
              >
                {gettext("Cancel")}
              </button>
              <button
                phx-click="confirm_delete"
                phx-value-id={@card_to_delete.id}
                class="px-4 py-2 text-sm font-medium text-white bg-red-600 border border-transparent rounded-md shadow-sm hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
              >
                {gettext("Delete")}
              </button>
            </div>
          </div>
        </.modal>
    <% end %>
  <% end %>
</div>
