<div
  class="min-h-screen bg-gradient-to-b from-indigo-100 via-purple-50 to-pink-100"
  phx-hook="CardConfettiEffect"
  id="card-confetti-container"
>
  <header
    class="fixed top-0 left-0 right-0 z-40 bg-white shadow-sm h-16 transition-transform duration-300"
    phx-hook="HideableHeader"
    id="hideable-header"
  >
    <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8">
      <div class="relative h-full">
        <div class="absolute left-0 top-1/2 -translate-y-1/2">
        <.link navigate={~p"/dashboard"} class="block">
          <div class="w-8 h-8 bg-purple-600 rounded-full flex items-center justify-center">
            <.icon name="hero-gift" class="h-5 w-5 text-white" />
          </div>
        </.link>
        </div>

        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
          <h1 class="text-xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent whitespace-nowrap">
            {gettext("Wishlists Manager")}
          </h1>
        </div>

        <div class="absolute right-0 top-1/2 -translate-y-1/2">
          <div class="relative group">
            <button class="w-auto px-3 h-12 rounded-full flex items-center justify-center hover:bg-gray-100 transition-colors">
              <div class="flex items-center space-x-2">
                <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center">
                  <span class="text-sm font-medium text-gray-600">
                    {String.first(@current_user.account.username)}
                  </span>
                </div>
                <span class="hidden sm:block text-sm font-medium text-gray-600">
                  {@current_user.account.username}
                </span>
              </div>
            </button>

            <div class="absolute h-3 w-full bottom-0 translate-y-full"></div>

            <div class="hidden group-hover:block absolute right-0 top-[calc(100%+0.75rem)] w-48 bg-white rounded-lg shadow-lg border border-gray-200 py-2">
              <div class="px-4 py-2 border-b border-gray-100">
                <p class="text-sm font-medium text-gray-900">
                  {@current_user.account.username}
                </p>
                <p class="text-xs text-gray-500">
                  {@current_user.email}
                </p>
              </div>

              <.link
                href={~p"/auth/sign_out"}
                method="delete"
                class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
              >
                {gettext("Sign out")}
              </.link>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="h-16"></div>

  <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Wishlists Section -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span>🎁</span> {gettext("My Wishlists")}
          </h2>
          <p class="text-sm text-gray-600">
            {gettext("Organize your wishes into magical collections")}
          </p>
        </div>

        <button
          phx-click="new_folder"
          class="w-full sm:w-auto bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-4 py-2 sm:px-6 sm:py-3 rounded-full hover:from-indigo-700 hover:to-purple-700 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center justify-center space-x-2 group"
        >
          <div class="relative">
            <.icon
              name="hero-plus"
              class="h-5 w-5 transition-transform duration-300 group-hover:scale-110"
            />
          </div>
          <span>{gettext("New Collection")}</span>
        </button>
      </div>

      <!-- Filters and Folders -->
      <div class="flex flex-col sm:flex-row gap-6">
        <!-- Filters -->
        <div class="w-full sm:w-48 bg-white/50 backdrop-blur-sm rounded-xl p-2 flex-shrink-0 mb-4">
          <div class="space-y-1">
            <button
              phx-click="filter_folders"
              phx-value-filter="all"
              class={[
                "w-full px-3 py-1.5 rounded-lg text-left transition-all duration-200",
                "flex items-center space-x-2",
                @current_filter == "all" &&
                  "bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-md",
                @current_filter != "all" &&
                  "hover:bg-white/50 text-gray-700 hover:text-indigo-700"
              ]}
            >
              <.icon name="hero-squares-2x2" class="h-4 w-4" />
              <span class="text-sm font-medium">{gettext("All Collections")}</span>
              <span class="ml-auto bg-white/20 px-1.5 py-0.5 rounded-full text-xs">
                {length(@folders) + length(@followed_folders)}
              </span>
            </button>

            <button
              phx-click="filter_folders"
              phx-value-filter="own"
              class={[
                "w-full px-3 py-1.5 rounded-lg text-left transition-all duration-200",
                "flex items-center space-x-2",
                @current_filter == "own" &&
                  "bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-md",
                @current_filter != "own" &&
                  "hover:bg-white/50 text-gray-700 hover:text-indigo-700"
              ]}
            >
              <.icon name="hero-folder" class="h-4 w-4" />
              <span class="text-sm font-medium">{gettext("My Collections")}</span>
              <span class="ml-auto bg-white/20 px-1.5 py-0.5 rounded-full text-xs">
                {length(@folders)}
              </span>
            </button>

            <button
              phx-click="filter_folders"
              phx-value-filter="shared"
              class={[
                "w-full px-3 py-1.5 rounded-lg text-left transition-all duration-200",
                "flex items-center space-x-2",
                @current_filter == "shared" &&
                  "bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-md",
                @current_filter != "shared" &&
                  "hover:bg-white/50 text-gray-700 hover:text-indigo-700"
              ]}
            >
              <.icon name="hero-share" class="h-4 w-4" />
              <span class="text-sm font-medium">{gettext("Shared")}</span>
              <span class="ml-auto bg-white/20 px-1.5 py-0.5 rounded-full text-xs">
                {length(@followed_folders)}
              </span>
            </button>
          </div>
        </div>

        <div class="flex-1 min-w-0">
          <div class="relative">
            <div class="overflow-x-auto hide-scrollbar -mr-4 min-h-[100px]">
              <div class="flex space-x-4 pb-4 pr-4">
                <%= for folder <- filter_folders(@folders, @followed_folders, @current_filter) do %>
                  <div class="flex-none w-64">
                    <div
                      class={[
                        "bg-white/95 backdrop-blur-sm rounded-2xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 relative group transform hover:-translate-y-1 drag-target border border-gray-100",
                        is_map(folder) && Map.has_key?(folder, :user_id) &&
                          folder.user_id != @current_user.id &&
                          "bg-gradient-to-r from-purple-200/95 to-pink-200/95"
                      ]}
                      data-folder-id={folder.id}
                      data-owner={
                        if folder.user_id == @current_user.id, do: "true", else: "false"
                      }
                      id={"folder-drop-target-#{folder.id}"}
                    >
                      <.link
                        navigate={get_folder_path(folder, @current_user)}
                        class="absolute inset-0 z-10"
                      >
                      </.link>

                      <div class="absolute -top-2 -right-2 opacity-0 group-hover:opacity-100 transition-opacity">
                        <span class="inline-block animate-bounce">✨</span>
                      </div>

                      <div class="flex justify-between items-center mb-2">
                        <h3 class="text-xl font-bold text-indigo-900 truncate max-w-[11ch]">
                          {folder.name}
                        </h3>
                        <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                          {folder.card_count} {if folder.card_count == 1,
                            do: gettext("item"),
                            else: gettext("items")}
                        </span>
                      </div>

                      <div class="mb-3 min-h-[1.5rem]">
                        <%= if folder.event_date do %>
                          <span class={[
                            "font-medium",
                            cond do
                              Date.compare(folder.event_date, @current_time) == :lt ->
                                "text-purple-600"

                              Date.diff(folder.event_date, @current_time) == 0 ->
                                "text-emerald-600"

                              Date.diff(folder.event_date, @current_time) == 1 ->
                                "text-indigo-600"

                              true ->
                                "text-indigo-700"
                            end
                          ]}>
                            {format_event_date(folder.event_date)}
                          </span>
                        <% else %>
                          <span class="text-gray-400">
                            {gettext("No event date set")}
                          </span>
                        <% end %>
                      </div>

                      <div class="flex justify-end">
                        <div class="flex items-center space-x-2">
                          <%= if is_map(folder) && Map.has_key?(folder, :user_id) && folder.user_id != @current_user.id do %>
                            <span class="bg-purple-600 text-white text-xs px-2 py-1 rounded-full">
                              {gettext("Shared by")} {folder.user.account.username}
                            </span>
                          <% else %>
                            <div class="text-purple-600 hover:text-purple-800 font-medium flex items-center space-x-1 group">
                              <span>{gettext("Open Collection")}</span>
                              <.icon
                                name="hero-sparkles"
                                class="h-4 w-4 group-hover:animate-pulse"
                              />
                            </div>
                          <% end %>
                        </div>
                      </div>

                      <div class="absolute inset-0 border-2 border-dashed border-indigo-300 rounded-2xl opacity-0 pointer-events-none drag-area">
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

<!-- Wishes Section -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 flex items-center gap-2">
            <span>⭐</span> {gettext("My Wishes")}
          </h2>
          <p class="text-sm text-gray-600">{gettext("Dreams waiting to come true")}</p>
        </div>

        <button
          phx-click="new_card"
          class="w-full sm:w-auto bg-gradient-to-r from-purple-600 to-pink-600 text-white px-4 py-2 sm:px-6 sm:py-3 rounded-full hover:from-purple-700 hover:to-pink-700 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center justify-center space-x-2"
        >
          <.icon name="hero-sparkles" class="h-5 w-5" />
          <span>{gettext("Make a Wish")}</span>
        </button>
      </div>

      <%= if Enum.empty?(@cards) do %>
        <!-- Empty state -->
        <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg p-6 sm:p-12 text-center">
          <h3 class="text-2xl font-bold text-indigo-900 mb-4">
            {gettext("Your wish list is empty")}
          </h3>
          <p class="text-indigo-600 mb-8">
            {gettext(
              "Add your wish by clicking 'Make a Wish' button. Then you can add it to any collection above!"
            )}
          </p>
        </div>
      <% else %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          <%= for card <- @cards do %>
            <div class="w-full mx-auto sm:w-full sm:mx-0">
              <div class="bg-white/80 rounded-2xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 h-full relative">
                <div
                  class="relative h-48 mb-4 overflow-hidden rounded-xl"
                  phx-click="edit_card"
                  phx-value-id={card.id}
                >
                  <img
                    src={
                      if card.image_url && card.image_url != "",
                        do: card.image_url,
                        else: "/images/gift.jpg"
                    }
                    alt={card.title}
                    class="w-full h-full object-cover rounded-xl transition-transform duration-300 hover:scale-105"
                    loading="lazy"
                    phx-hook="ImageLoader"
                    id={"image-#{card.id}"}
                    onerror="this.src='/images/gift.jpg'"
                  />

                  <button
                    class="absolute top-2 right-2 bg-white/90 w-8 h-8 rounded-full p-1.5 shadow-md opacity-0 group-hover:opacity-100 transition-opacity hover:bg-indigo-50 flex items-center justify-center"
                    phx-click="edit_card"
                    phx-value-id={card.id}
                  >
                    <.icon name="hero-pencil" class="h-5 w-5 text-indigo-600" />
                  </button>
                </div>

                <div class="flex items-center justify-between mb-8">
                  <h3 class="text-xl font-bold text-indigo-900 line-clamp-1 mr-2">
                    {card.title}
                  </h3>
                  <%= if card.link_url do %>
                    <a
                      href={card.link_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex-shrink-0 text-purple-600 hover:text-purple-800 flex items-center space-x-1 transition-colors duration-200"
                    >
                      <.icon name="hero-arrow-top-right-on-square" class="h-5 w-5" />
                    </a>
                  <% end %>
                </div>


                <div class="absolute inset-x-0 -bottom-2 p-3">
                  <div class="bg-white/80 rounded-2xl p-3">
                    <div class="relative">
                      <%= if @show_folders_for_card == Integer.to_string(card.id) do %>
                        <div class="absolute left-0 right-0 -bottom-4 w-full my-1">
                          <div class="overflow-x-auto hide-scrollbar w-full">
                            <div class="flex space-x-2 min-w-min">
                              <%= for folder <- @folders do %>
                                <button
                                  class="flex-none px-4 py-2 rounded-lg bg-white/80 hover:bg-indigo-100 transition-all duration-200 flex items-center space-x-2 cursor-pointer hover:shadow-sm transform hover:-translate-y-0.5"
                                  phx-click="assign_card"
                                  phx-value-card_id={card.id}
                                  phx-value-folder_id={folder.id}
                                >
                                  <div class="w-6 h-6 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0">
                                    <span class="text-sm font-medium text-indigo-700">
                                      {String.first(folder.name)}
                                    </span>
                                  </div>
                                  <span class="text-sm font-medium text-gray-700 whitespace-nowrap">
                                    {folder.name}
                                  </span>
                                </button>
                              <% end %>
                            </div>
                          </div>
                        </div>
                      <% else %>
                        <button
                          class="w-full flex items-center justify-center space-x-2 text-indigo-600 hover:text-indigo-800 transition-colors duration-200"
                          phx-click="toggle_folders"
                          phx-value-card_id={card.id}
                        >
                          <.icon name="hero-folder-plus" class="h-5 w-5" />
                          <span class="text-sm font-medium">{gettext("Add to collection")}</span>
                        </button>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>
  </main>

  <%= if @show_modal do %>
    <%= case @modal_type do %>
      <% :folder -> %>
        <.live_component
          module={WishlistsWeb.FolderLive.FolderFormComponent}
          id="folder-form"
          action={@action}
          folder={@folder}
          modal_title={@modal_title}
          submit_button_text={@submit_button_text}
          current_user={@current_user}
        />
      <% :card -> %>
        <.live_component
          module={WishlistsWeb.CardLive.CardFormComponent}
          id="new-card"
          action={@action}
          card={@card}
          modal_title={@modal_title}
          submit_button_text={@submit_button_text}
          current_user={@current_user}
          parent_pid={@parent_pid}
        />
    <% end %>
  <% end %>
</div>
