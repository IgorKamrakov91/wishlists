<div class="w-full">
  <!-- Full screen main section -->
  <div class="h-screen relative flex items-center justify-center">
    <!-- Video Background -->
    <div class="absolute inset-0 w-full h-full overflow-hidden">
      <div class="absolute inset-0 bg-black bg-opacity-50 z-10"></div>
      <video autoplay loop muted playsinline class="absolute w-full h-full object-cover">
        <source
          src="https://res.cloudinary.com/dkkqvw4aw/video/upload/v1708953576/xfkji1qw9wbtoafvgzqu.mp4"
          type="video/mp4"
        /> Your browser does not support the video tag.
      </video>
    </div>

<!-- Centered Content -->
    <div class="relative z-20 text-center px-4 max-w-4xl mx-auto">
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl mb-8">
        Wishlists Manager
      </h1>

      <p class="text-xl text-gray-200 mb-12">
        Create and manage your wishlists effortlessly. Keep track of all the things you dream about!
      </p>

      <button
        type="button"
        phx-click="open_auth_modal"
        class="rounded-md bg-indigo-600 px-8 py-4 text-lg font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all duration-300 ease-in-out transform hover:scale-105"
      >
        Get Started
      </button>
    </div>

<!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 animate-bounce">
      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"
        />
      </svg>
    </div>
  </div>

<!-- Footer (now appears below the fold) -->
  <footer class="bg-white border-t border-gray-200 w-full py-8">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Contact Info -->
          <div class="text-center md:text-left">
            <h3 class="text-sm font-semibold text-gray-600 uppercase">Contact</h3>
            <p class="mt-2 text-sm text-gray-500">
              Email: contact@wishlistsmanager.com<br /> Phone: (555) 123-4567
            </p>
          </div>

<!-- Quick Links -->
          <div class="text-center">
            <h3 class="text-sm font-semibold text-gray-600 uppercase">Quick Links</h3>
            <ul class="mt-2 space-y-2">
              <li><a href="#" class="text-sm text-gray-500 hover:text-gray-600">About Us</a></li>
              <li>
                <a href="#" class="text-sm text-gray-500 hover:text-gray-600">Terms of Service</a>
              </li>
              <li>
                <a href="#" class="text-sm text-gray-500 hover:text-gray-600">Privacy Policy</a>
              </li>
            </ul>
          </div>

<!-- Social Links -->
          <div class="text-center md:text-right">
            <h3 class="text-sm font-semibold text-gray-600 uppercase">Follow Us</h3>
            <div class="mt-2 flex justify-center md:justify-end space-x-4">
              <!-- Social icons remain the same -->
            </div>
          </div>
        </div>

<!-- Copyright -->
        <div class="mt-8 border-t border-gray-200 pt-4">
          <p class="text-center text-sm text-gray-500">
            © 2024 Wishlists Manager. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </footer>

  <%= if @show_auth_modal do %>
    <.live_component module={WishlistsWeb.AuthComponent} id="auth-modal" />
  <% end %>
</div>
