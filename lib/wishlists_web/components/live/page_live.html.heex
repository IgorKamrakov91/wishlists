<div class="w-full" id="locale-container" phx-hook="Locale">
  <div class="h-screen relative flex items-center justify-center">
    <!-- Locale Switcher -->
    <div class="absolute top-4 right-4 z-30">
      <div class="flex items-center space-x-2 bg-white/10 backdrop-blur-sm rounded-full p-1.5 shadow-lg">
        <div class="mr-2 text-white/80">
          <.icon name="hero-globe-alt" class="h-4 w-4" />
        </div>
        <button
          phx-click="switch_locale"
          phx-value-locale="en"
          class={[
            "px-3 py-1.5 rounded-full text-sm font-medium transition-all duration-200",
            @locale == "en" && "bg-indigo-600 text-white shadow-md transform scale-105",
            @locale != "en" && "text-white/90 hover:bg-white/20"
          ]}
        >
          EN
        </button>
        <button
          phx-click="switch_locale"
          phx-value-locale="ru"
          class={[
            "px-3 py-1.5 rounded-full text-sm font-medium transition-all duration-200",
            @locale == "ru" && "bg-indigo-600 text-white shadow-md transform scale-105",
            @locale != "ru" && "text-white/90 hover:bg-white/20"
          ]}
        >
          RU
        </button>
      </div>
    </div>
    
<!-- Video Background -->
    <div class="absolute inset-0 w-full h-full overflow-hidden">
      <div class="absolute inset-0 bg-black bg-opacity-50 z-10"></div>
      <video autoplay loop muted playsinline class="absolute w-full h-full object-cover">
        <source
          src="https://res.cloudinary.com/dkkqvw4aw/video/upload/v1708953576/xfkji1qw9wbtoafvgzqu.mp4"
          type="video/mp4"
        />
      </video>
    </div>
    
<!-- Centered Content -->
    <div class="relative z-20 text-center px-4 max-w-4xl mx-auto">
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl mb-8">
        {@translations["title"]}
      </h1>

      <p class="text-xl text-gray-200 mb-12">
        {@translations["description"]}
      </p>

      <button
        type="button"
        phx-click="open_auth_modal"
        class="rounded-md bg-gradient-to-r from-indigo-600 to-purple-600 px-8 py-4 text-lg font-semibold text-white shadow-lg hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all duration-300 ease-in-out transform hover:scale-105 hover:from-indigo-500 hover:to-purple-500 relative group"
      >
        <div class="absolute inset-0 rounded-md bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        </div>
        <div class="absolute -inset-1 rounded-md bg-gradient-to-r from-indigo-400 to-purple-400 opacity-20 blur-lg group-hover:opacity-30 transition-opacity duration-300">
        </div>
        {@translations["get_started"]}
      </button>
    </div>
  </div>

  <.live_component
    module={WishlistsWeb.HowItWorksComponent}
    id="how-it-works"
    translations={@translations}
  />
  
<!-- Footer (now appears below the fold) -->
  <footer class="bg-white border-t border-gray-200 w-full py-8">
    <div class="container mx-auto px-4">
      <div class="max-w-md mx-auto">
        <div class="flex flex-col items-center text-center">
          <!-- Contact Info -->
          <div>
            <h3 class="text-sm font-semibold text-gray-600 uppercase">
              {@translations["contact"]}
            </h3>
            <p class="mt-2 text-sm text-gray-500">
              {@translations["email"]}<br />
            </p>
          </div>

          <div class="mt-8 border-t border-gray-200 pt-4 w-full">
            <p class="text-sm text-gray-500">
              {@translations["copyright"]}
            </p>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <%= if @show_auth_modal do %>
    <.live_component module={WishlistsWeb.AuthComponent} id="auth-modal" />
  <% end %>
</div>
