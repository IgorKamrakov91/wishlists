<div class="min-h-screen bg-gradient-to-b from-indigo-100 via-purple-50 to-pink-100">
  <%= if @show_name_modal do %>
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 flex items-center justify-center">
      <div class="bg-white rounded-lg p-8 max-w-md w-full">
        <h2 class="text-2xl font-bold mb-4">Welcome!</h2>
        <p class="mb-4">Please enter your name to continue viewing this collection</p>

        <.form for={%{"guest_viewer" => %{}}} phx-submit="save_viewer_name">
          <.input type="text" name="guest_viewer[name]" required placeholder="Your name" />
          <.button type="submit" class="mt-4 w-full">Continue</.button>
        </.form>
      </div>
    </div>
  <% else %>
    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-gray-900"><%= @folder.name %></h1>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <%= for card <- @cards do %>
          <div class="bg-white rounded-lg shadow p-6">
            <div class="aspect-w-16 aspect-h-9 mb-4">
              <img src={card.image_url} alt={card.title} class="object-cover rounded-lg">
            </div>
            <h3 class="text-lg font-medium text-gray-900"><%= card.title %></h3>
            <%= if card.link_url do %>
              <a href={card.link_url} target="_blank" class="text-indigo-600 hover:text-indigo-900">
                Visit Link
              </a>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
