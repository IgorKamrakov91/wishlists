<div
  class="min-h-screen bg-gradient-to-b from-indigo-100 via-purple-50 to-pink-100"
  phx-hook="CopyToClipboard"
  id="clipboard-container"
>
  <input type="text" id="share-url-input" value={@share_url} class="hidden" />

  <header class="fixed top-0 left-0 right-0 z-40 bg-white shadow-sm h-16">
    <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8">
      <div class="relative h-full">
        <div class="absolute left-0 top-1/2 -translate-y-1/2">
          <.link navigate={~p"/dashboard"} class="block">
            <div class="w-8 h-8 bg-purple-600 rounded-full flex items-center justify-center">
              <.icon name="hero-gift" class="h-5 w-5 text-white" />
            </div>
          </.link>
        </div>

        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
          <h1 class="text-lg font-semibold text-gray-900">
            {@folder.name}
          </h1>
        </div>

        <div class="absolute right-0 top-1/2 -translate-y-1/2">
          <div class="relative group">
            <button class="w-10 h-10 rounded-full flex items-center justify-center hover:bg-gray-100 transition-colors">
              <.icon name="hero-ellipsis-horizontal" class="h-5 w-5 text-gray-600" />
            </button>

            <div class="absolute -bottom-3 left-0 right-0 h-3 bg-transparent group-hover:block hidden">
            </div>

            <div class="hidden group-hover:block absolute right-0 top-[calc(100%+0.75rem)] w-56 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50">
              <button
                phx-click="edit_folder"
                class="w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-50 flex items-center space-x-2"
              >
                <.icon name="hero-pencil" class="h-4 w-4" />
                <span>{gettext("Edit")}</span>
              </button>

              <button
                phx-click="show_delete_modal"
                class="w-full px-4 py-2 text-left text-sm text-rose-600 hover:bg-rose-50 flex items-center space-x-2"
              >
                <.icon name="hero-trash" class="h-4 w-4" />
                <span>{gettext("Delete")}</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="h-16"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="bg-white/80 backdrop-blur-sm rounded-lg shadow-sm p-4">
      <div class="hidden sm:flex sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <%= if @folder.event_date do %>
            <div class="flex items-center text-gray-600">
              <.icon name="hero-calendar" class="h-5 w-5 mr-2" />
              <span class="text-sm">
                {Calendar.strftime(@folder.event_date, "%d.%m.%Y")}
              </span>
            </div>
          <% end %>

          <div class="flex items-center text-gray-600">
            <.icon name="hero-gift" class="h-5 w-5 mr-2" />
            <span class="text-sm">
              {length(@cards)} {if length(@cards) == 1,
                do: gettext("item"),
                else: gettext("items")}
            </span>
          </div>

          <%= if @folder.description && @folder.description != "" do %>
            <div class="flex items-center text-gray-600">
              <.icon name="hero-information-circle" class="h-5 w-5 mr-2" />
              <span class="text-sm">
                {@folder.description}
              </span>
            </div>
          <% end %>

          <%= if @folder.show_reserver_names do %>
            <div class="flex items-center text-purple-600">
              <.icon name="hero-eye" class="h-5 w-5 mr-2" />
              <span class="text-sm font-medium">{gettext("Names visible")}</span>
            </div>
          <% else %>
            <div class="flex items-center text-gray-600">
              <.icon name="hero-eye-slash" class="h-5 w-5 mr-2" />
              <span class="text-sm font-medium">{gettext("Names hidden")}</span>
            </div>
          <% end %>
        </div>

        <button
          phx-click="share_folder"
          class="flex items-center gap-2 px-4 py-2 bg-emerald-100 hover:bg-emerald-200 text-emerald-700 rounded-full transition-colors"
          onclick={"copyToClipboard(event, '#{@share_url}')"}
        >
          <.icon name="hero-share" class="h-4 w-4" />
          <span class="text-sm font-medium">{gettext("Share Wishlist")}</span>
        </button>
      </div>

<!-- Мобильная версия -->
      <div class="flex sm:hidden flex-col gap-3">
        <%= if @folder.event_date do %>
          <div class="flex items-center text-gray-600">
            <.icon name="hero-calendar" class="h-5 w-5 mr-2" />
            <span class="text-sm">
              {Calendar.strftime(@folder.event_date, "%B %d, %Y")}
            </span>
          </div>
        <% end %>

        <div class="flex items-center text-gray-600">
          <.icon name="hero-gift" class="h-5 w-5 mr-2" />
          <span class="text-sm">
            {ngettext("1 item", "%{count} items", length(@cards), count: length(@cards))}
          </span>
        </div>

        <%= if @folder.description && @folder.description != "" do %>
          <div class="flex items-center text-gray-600">
            <.icon name="hero-information-circle" class="h-5 w-5 mr-2" />
            <span class="text-sm">
              {@folder.description}
            </span>
          </div>
        <% end %>

        <%= if @folder.show_reserver_names do %>
          <div class="flex items-center text-purple-600">
            <.icon name="hero-eye" class="h-5 w-5 mr-2" />
            <span class="text-sm font-medium">{gettext("Names visible")}</span>
          </div>
        <% else %>
          <div class="flex items-center text-gray-600">
            <.icon name="hero-eye-slash" class="h-5 w-5 mr-2" />
            <span class="text-sm font-medium">{gettext("Names hidden")}</span>
          </div>
        <% end %>

        <button
          phx-click="share_folder"
          class="flex items-center justify-center gap-2 px-4 py-2 bg-emerald-100 hover:bg-emerald-200 text-emerald-700 rounded-full transition-colors w-full mt-2"
          onclick={"copyToClipboard(event, '#{@share_url}')"}
        >
          <.icon name="hero-share" class="h-4 w-4" />
          <span class="text-sm font-medium">{gettext("Share Wishlist")}</span>
        </button>
      </div>
    </div>
  </div>

  <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <%= if Enum.empty?(@cards) do %>
      <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg p-6 sm:p-12 text-center">
        <div class="mx-auto h-24 w-24 text-indigo-300 mb-6">
          <.icon name="hero-folder-open" class="h-24 w-24" />
        </div>
        <h3 class="text-2xl font-bold text-indigo-900 mb-4">
          {gettext("This collection is empty")}
        </h3>
        <p class="text-indigo-600 mb-8">
          {gettext("Start by adding new wishes or adding them from your dashboard")}
        </p>
        <div class="flex justify-center">
          <button
            phx-click="new_card"
            class="bg-gradient-to-r from-purple-600 to-pink-600 text-white px-6 py-3 rounded-full hover:from-purple-700 hover:to-pink-700 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center space-x-2"
          >
            <.icon name="hero-plus" class="h-5 w-5" />
            <span>{gettext("Add Wishes")}</span>
          </button>
        </div>
      </div>
    <% else %>
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6"
        id="folder-cards-container"
      >
        <%= for {folder_card, index} <- Enum.with_index(@cards, 1) do %>
          <div
            data-card-id={folder_card.card.id}
            data-position={index}
            class="group w-full mx-auto sm:w-full sm:mx-0"
          >
            <div class={[
              "bg-white/90 backdrop-blur-sm rounded-2xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 relative",
              folder_card.card.status == "pending" && "bg-gray-50/90",
              folder_card.reservation && "bg-purple-50/90"
            ]}>
              <%= if folder_card.card.status == "pending" do %>
                <div class="absolute top-2 left-2 bg-yellow-600 text-white px-3 py-1 rounded-full text-sm z-10">
                  {gettext("Pending Approval")}
                </div>
              <% end %>

              <div class="relative h-48 mb-4 overflow-hidden rounded-xl">
                <%= if folder_card.card.link_url do %>
                  <a
                    href={folder_card.card.link_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block h-full"
                  >
                    <img
                      src={folder_card.card.image_url || "/images/gift.jpg"}
                      alt={folder_card.card.title}
                      class="w-full h-full object-cover rounded-xl transition-transform duration-300 hover:scale-105"
                      loading="lazy"
                      phx-hook="ImageLoader"
                      id={"image-#{folder_card.card.id}"}
                      onerror="this.src='/images/gift.jpg'"
                    />
                  </a>
                <% else %>
                  <img
                    src={folder_card.card.image_url || "/images/gift.jpg"}
                    alt={folder_card.card.title}
                    class="w-full h-full object-cover rounded-xl"
                    loading="lazy"
                    phx-hook="ImageLoader"
                    id={"image-#{folder_card.card.id}"}
                    onerror="this.src='/images/gift.jpg'"
                  />
                <% end %>

                <%= if folder_card.reservation do %>
                  <div class="absolute inset-0 bg-black/5 backdrop-blur-[2px]"></div>
                  <div class="absolute top-2 left-2 bg-purple-600 text-white px-3 py-1 rounded-full text-sm">
                    <%= if @folder.show_reserver_names do %>
                      {gettext("Reserved by %{name}",
                        name: folder_card.reservation.reserver_name
                      )}
                    <% else %>
                      {gettext("Reserved")}
                    <% end %>
                  </div>
                <% end %>

                <%= if folder_card.card.status == "pending" do %>
                  <div class="absolute inset-0 flex opacity-0 group-hover:opacity-100 transition-opacity">
                    <button
                      phx-click="reject_card"
                      phx-value-id={folder_card.card.id}
                      class="w-1/2 h-full bg-rose-500/75 hover:bg-rose-500/90 flex items-center justify-center transition-colors duration-200"
                      title={gettext("Reject suggestion")}
                    >
                      <.icon name="hero-x-mark" class="h-12 w-12 text-white" />
                    </button>

                    <button
                      phx-click="approve_card"
                      phx-value-id={folder_card.card.id}
                      class="w-1/2 h-full bg-emerald-500/75 hover:bg-emerald-500/90 flex items-center justify-center transition-colors duration-200"
                      title={gettext("Approve suggestion")}
                    >
                      <.icon name="hero-check" class="h-12 w-12 text-white" />
                    </button>
                  </div>
                <% end %>
              </div>

              <h3 class="text-lg font-semibold text-gray-900 mb-2 line-clamp-1 cursor-move">
                {folder_card.card.title}
              </h3>

              <div class="flex items-center justify-between">
                <span class="text-indigo-600 font-medium">
                  <%= if folder_card.card.price && folder_card.card.price > 0 do %>
                    {format_price(folder_card.card.price)}
                  <% else %>
                    <span class="text-gray-400 text-sm">{gettext("No Price")}</span>
                  <% end %>
                </span>

                <%= if folder_card.card.link_url do %>
                  <a
                    href={folder_card.card.link_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-purple-600 hover:text-purple-800 text-sm flex items-center space-x-1"
                  >
                    <span>{gettext("Visit Link")}</span>
                    <.icon name="hero-arrow-top-right-on-square" class="h-4 w-4" />
                  </a>
                <% end %>
              </div>

              <button
                phx-click="remove_card"
                phx-value-card_id={folder_card.card.id}
                class="absolute top-2 right-2 bg-white/90 w-8 h-8 rounded-full shadow-md opacity-0 group-hover:opacity-100 transition-opacity hover:bg-rose-50 flex items-center justify-center"
              >
                <.icon name="hero-x-mark" class="h-4 w-4 text-rose-600" />
              </button>
            </div>
          </div>
        <% end %>
      </div>

      <div class="flex justify-center mt-8">
        <button
          phx-click="new_card"
          class="bg-gradient-to-r from-purple-600 to-pink-600 text-white px-6 py-3 rounded-full hover:from-purple-700 hover:to-pink-700 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center space-x-2"
        >
          <.icon name="hero-plus" class="h-5 w-5" />
          <span>{gettext("Add Wishes")}</span>
        </button>
      </div>
    <% end %>
  </main>

  <%= if @show_modal do %>
    <%= case @modal_type do %>
      <% :folder -> %>
        <.live_component
          module={WishlistsWeb.FolderLive.FolderFormComponent}
          id="folder-form"
          action={@action}
          folder={@folder}
          modal_title={@modal_title}
          submit_button_text={@submit_button_text}
          current_user={@current_user}
        />
      <% :card -> %>
        <.live_component
          module={WishlistsWeb.CardLive.CardFormComponent}
          id="card-form"
          action={@action}
          card={@card}
          modal_title={@modal_title}
          submit_button_text={@submit_button_text}
          current_user={@current_user}
          folder={@folder}
        />
    <% end %>
  <% end %>

  <%= if @show_delete_modal do %>
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity z-50">
      <div class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
          <div class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg sm:p-6">
            <div class="sm:flex sm:items-start">
              <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                <.icon name="hero-exclamation-triangle" class="h-6 w-6 text-red-600" />
              </div>
              <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                <h3 class="text-base font-semibold leading-6 text-gray-900">
                  {gettext("Delete Folder")}
                </h3>
                <div class="mt-2">
                  <p class="text-sm text-gray-500">
                    {gettext(
                      "Are you sure you want to delete this folder? This action cannot be undone, and all cards will be removed from this folder."
                    )}
                  </p>
                </div>
              </div>
            </div>
            <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
              <button
                type="button"
                phx-click="delete_folder"
                class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto"
              >
                {gettext("Delete")}
              </button>
              <button
                type="button"
                phx-click="hide_delete_modal"
                class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto"
              >
                {gettext("Cancel")}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @show_share_modal do %>
    <div class="fixed bottom-4 right-4 bg-emerald-500 text-white px-6 py-3 rounded-full shadow-lg transform transition-all duration-300 flex items-center space-x-2">
      <.icon name="hero-check-circle" class="h-5 w-5" />
      <span>{gettext("Link copied to clipboard!")}</span>
    </div>
  <% end %>
</div>
