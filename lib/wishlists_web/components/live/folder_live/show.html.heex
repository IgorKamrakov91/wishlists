<div class="min-h-screen bg-gradient-to-b from-indigo-100 via-purple-50 to-pink-100">
  <header class="bg-white/80 backdrop-blur-sm shadow-lg">
    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8 flex justify-between items-center">
      <div class="flex items-center space-x-6">
        <.link
          navigate={~p"/dashboard"}
          class="flex items-center space-x-2 text-indigo-600 hover:text-indigo-800 transition-colors duration-200"
        >
          <.icon name="hero-arrow-left" class="h-5 w-5" />
          <span>Back</span>
        </.link>

        <div class="flex items-center space-x-3">
          <div class="h-12 w-12 bg-indigo-600 rounded-full flex items-center justify-center">
            <.icon name="hero-folder" class="h-6 w-6 text-white" />
          </div>
          <div>
            <h1 class="text-3xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
              {@folder.name}
            </h1>
            <%= if @folder.description do %>
              <p class="text-sm text-gray-600">{@folder.description}</p>
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex items-center space-x-3">
        <button
          phx-click="edit_folder"
          class="bg-white/80 backdrop-blur-sm text-indigo-600 px-4 py-2 rounded-full hover:bg-indigo-50 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center space-x-2"
        >
          <.icon name="hero-pencil" class="h-4 w-4" />
          <span>Edit</span>
        </button>

        <button
          phx-click="delete_folder"
          data-confirm="Are you sure you want to delete this folder?"
          class="bg-gradient-to-r from-rose-400 to-red-500 hover:from-rose-500 hover:to-red-600 text-white px-4 py-2 rounded-full transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center space-x-2"
        >
          <.icon name="hero-trash" class="h-4 w-4" />
          <span>Delete</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 sm:px-0">
      <%= if Enum.empty?(@cards) do %>
        <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg p-12 text-center">
          <div class="mx-auto h-24 w-24 text-indigo-300 mb-6">
            <.icon name="hero-folder-open" class="h-24 w-24" />
          </div>
          <h3 class="text-2xl font-bold text-indigo-900 mb-4">This collection is empty</h3>
          <p class="text-indigo-600 mb-8">
            Start by dragging wishes from your dashboard to this collection
          </p>
          <.link
            navigate={~p"/dashboard"}
            class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-6 py-3 rounded-full hover:from-indigo-700 hover:to-purple-700 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 inline-flex items-center space-x-2"
          >
            <.icon name="hero-plus" class="h-5 w-5" />
            <span>Add Wishes</span>
          </.link>
        </div>
      <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
           id="folder-cards-container"
           data-folder-id={@folder.id}
           phx-hook="DragOrder">
        <%= for {card, index} <- Enum.with_index(@cards, 1) do %>
          <div data-card-id={card.id}
               data-position={index}
               class="cursor-move">
            <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 group transform hover:-translate-y-1">
              <!-- Image section -->
              <div class="relative h-48 mb-4">
                <%= if card.image_url && card.image_url != "" do %>
                  <img
                    src={card.image_url}
                    alt={card.title}
                    class="w-full h-full object-cover rounded-xl"
                    loading="lazy"
                  />
                <% else %>
                  <div class="w-full h-full bg-gradient-to-br from-indigo-100 to-purple-100 rounded-xl flex items-center justify-center">
                    <div class="text-center">
                      <.icon name="hero-photo" class="h-12 w-12 text-indigo-300 mx-auto mb-2" />
                      <p class="text-sm text-indigo-400">No image available</p>
                    </div>
                  </div>
                <% end %>

                <button
                  phx-click="remove_card"
                  phx-value-card-id={card.id}
                  class="absolute top-2 right-2 bg-white/90 rounded-full p-2 shadow-md opacity-0 group-hover:opacity-100 transition-opacity"
                >
                  <.icon name="hero-x-mark" class="h-4 w-4 text-rose-600" />
                </button>
              </div>

              <h3 class="text-xl font-bold text-indigo-900 mb-4 line-clamp-1">{card.title}</h3>

              <%= if card.description do %>
                <p class="text-sm text-indigo-600 mb-4 line-clamp-2">{card.description}</p>
              <% end %>

              <div class="flex items-center justify-between">
                <%= if card.link_url do %>
                  <a
                    href={card.link_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-purple-600 hover:text-purple-800 text-sm flex items-center space-x-1"
                  >
                    <span>Visit Link</span>
                    <.icon name="hero-arrow-top-right-on-square" class="h-4 w-4" />
                  </a>
                <% end %>

                <div class="flex items-center space-x-2">
                  <button
                    phx-click="move_card_up"
                    phx-value-card-id={card.id}
                    class="text-indigo-400 hover:text-indigo-600 transition-colors"
                  >
                    <.icon name="hero-arrow-up" class="h-5 w-5" />
                  </button>
                  <button
                    phx-click="move_card_down"
                    phx-value-card-id={card.id}
                    class="text-indigo-400 hover:text-indigo-600 transition-colors"
                  >
                    <.icon name="hero-arrow-down" class="h-5 w-5" />
                  </button>
                </div>
              </div>
            </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </main>

  <%= if @show_modal do %>
    <.live_component
      module={WishlistsWeb.FolderLive.FolderFormComponent}
      id="folder-form"
      action={@action}
      folder={@folder}
      modal_title={@modal_title}
      submit_button_text={@submit_button_text}
      current_user={@current_user}
    />
  <% end %>
</div>
