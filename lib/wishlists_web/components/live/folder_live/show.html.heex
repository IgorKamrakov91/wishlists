<div class="min-h-screen bg-gradient-to-b from-indigo-100 via-purple-50 to-pink-100">
  <header class="bg-white/80 backdrop-blur-sm shadow-lg">
    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8 flex justify-between items-center">
    <div class="flex items-center justify-between w-full">
      <.link
        navigate={~p"/dashboard"}
        class="group relative flex items-center space-x-2 px-4 py-2 bg-white/80 backdrop-blur-sm rounded-full shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5"
      >
        <div class="absolute inset-0 rounded-full bg-gradient-to-r from-indigo-600/10 to-purple-600/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <.icon name="hero-home" class="h-5 w-5 text-indigo-600 group-hover:scale-110 transition-transform duration-300" />
        <span class="text-indigo-600 font-medium group-hover:text-indigo-800 transition-colors duration-300">Dashboard</span>
      </.link>

      <div class="flex flex-col items-center mx-auto">
        <div class="flex items-center space-x-3">
          <div class="h-12 w-12 bg-indigo-600 rounded-full flex items-center justify-center">
            <.icon name="hero-folder" class="h-6 w-6 text-white" />
          </div>
          <div class="text-center">
            <h1 class="text-3xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
              {@folder.name}
            </h1>
            <%= if @folder.description do %>
              <p class="text-sm text-gray-600">{@folder.description}</p>
            <% end %>
          </div>
        </div>
      </div>

      <div class="w-[88px]"></div>
    </div>

      <div class="flex items-center space-x-3">
        <button
          phx-click="edit_folder"
          class="bg-white/80 backdrop-blur-sm text-indigo-600 px-4 py-2 rounded-full hover:bg-indigo-50 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center space-x-2"
        >
          <.icon name="hero-pencil" class="h-4 w-4" />
          <span>Edit</span>
        </button>

        <button
          phx-click="show_delete_modal"
          class="bg-gradient-to-r from-rose-400 to-red-500 hover:from-rose-500 hover:to-red-600 text-white px-4 py-2 rounded-full transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center space-x-2"
        >
          <.icon name="hero-trash" class="h-4 w-4" />
          <span>Delete</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 sm:px-0">
      <%= if Enum.empty?(@cards) do %>
        <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg p-12 text-center">
          <div class="mx-auto h-24 w-24 text-indigo-300 mb-6">
            <.icon name="hero-folder-open" class="h-24 w-24" />
          </div>
          <h3 class="text-2xl font-bold text-indigo-900 mb-4">This collection is empty</h3>
          <p class="text-indigo-600 mb-8">
            Start by dragging wishes from your dashboard to this collection
          </p>
          <.link
            navigate={~p"/dashboard"}
            class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-6 py-3 rounded-full hover:from-indigo-700 hover:to-purple-700 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-105 inline-flex items-center space-x-2"
          >
            <.icon name="hero-plus" class="h-5 w-5" />
            <span>Add Wishes</span>
          </.link>
        </div>
      <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
           id="folder-cards-container"
           data-folder-id={@folder.id}
           phx-hook="DragOrder">
        <%= for {card, index} <- Enum.with_index(@cards, 1) do %>
          <div data-card-id={card.id}
               data-position={index}
               class="cursor-move">
            <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-lg p-6 hover:shadow-xl transition-all duration-300 group transform hover:-translate-y-1">
              <!-- Image section -->
              <div class="relative h-48 mb-4">
                <img
                  src={if card.image_url && card.image_url != "", do: card.image_url, else: "/images/gift.jpg"}
                  alt={card.title}
                  class="w-full h-full object-cover rounded-xl"
                  loading="lazy"
                  phx-hook="ImageLoader"
                  id={"image-#{card.id}"}
                />

                <button
                  phx-click="remove_card"
                  phx-value-card_id={card.id}
                  class="absolute top-2 right-2 bg-white/90 w-8 h-8 rounded-full p-1.5 shadow-md opacity-0 group-hover:opacity-100 transition-opacity hover:bg-rose-50 hover:text-rose-700 flex items-center justify-center"
                >
                  <.icon name="hero-x-mark" class="h-4 w-4 text-rose-600" />
                </button>
              </div>

              <h3 class="text-xl font-bold text-indigo-900 mb-4 line-clamp-1">{card.title}</h3>

              <div class="flex items-center justify-between">
                <%= if card.link_url do %>
                  <a
                    href={card.link_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-purple-600 hover:text-purple-800 text-sm flex items-center space-x-1"
                  >
                    <span>Visit Link</span>
                    <.icon name="hero-arrow-top-right-on-square" class="h-4 w-4" />
                  </a>
                <% end %>

                <div class="flex items-center space-x-1">
                  <span class="text-indigo-600 font-medium">
                    <%= if card.price && card.price > 0 do %>
                      <%= "#{:erlang.float_to_binary(card.price, decimals: 0)} ₽" %>
                    <% else %>
                      <span class="text-indigo-400 text-sm">No Price</span>
                    <% end %>
                  </span>
                </div>
              </div>
            </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </main>

  <%= if @show_modal do %>
    <.live_component
      module={WishlistsWeb.FolderLive.FolderFormComponent}
      id="folder-form"
      action={@action}
      folder={@folder}
      modal_title={@modal_title}
      submit_button_text={@submit_button_text}
      current_user={@current_user}
    />
  <% end %>

  <%= if @show_delete_modal do %>
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity z-50">
      <div class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
          <div class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg sm:p-6">
            <div class="sm:flex sm:items-start">
              <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                <.icon name="hero-exclamation-triangle" class="h-6 w-6 text-red-600" />
              </div>
              <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                <h3 class="text-base font-semibold leading-6 text-gray-900">
                  Delete Folder
                </h3>
                <div class="mt-2">
                  <p class="text-sm text-gray-500">
                    Are you sure you want to delete this folder? This action cannot be undone, and all cards will be removed from this folder.
                  </p>
                </div>
              </div>
            </div>
            <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
              <button
                type="button"
                phx-click="delete_folder"
                class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto"
              >
                Delete
              </button>
              <button
                type="button"
                phx-click="hide_delete_modal"
                class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto"
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
