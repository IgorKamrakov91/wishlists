<main class="w-full h-full">
  <.flash_group flash={@flash} />
  {@inner_content}

  <%= if @current_user do %>
    <.live_component
      module={WishlistsWeb.NotificationComponent}
      id="notifications"
      current_user={@current_user}
    />
  <% end %>
</main>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.14.0/Sortable.min.js">
</script>
